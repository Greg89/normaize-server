# Production Environment Variables Template
# Copy this file and update with your actual values

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:$PORT

# =============================================================================
# DATABASE CONFIGURATION  
# =============================================================================

# PostgreSQL Connection String
# Format: Host=hostname;Database=dbname;Username=user;Password=password;Port=5432;SSL Mode=Require;
ConnectionStrings__DefaultConnection=Host=your-postgres-host;Database=normaize_prod;Username=your-db-user;Password=your-db-password;Port=5432;SSL Mode=Require;Trust Server Certificate=true

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Auth0 Settings (Required for API security)
Auth0__Domain=your-production-tenant.auth0.com
Auth0__Audience=normaize-api

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed Origins (Comma-separated list)
AllowedOrigins__0=https://your-client-domain.com
AllowedOrigins__1=https://your-admin-domain.com

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Serilog Minimum Level
Serilog__MinimumLevel__Default=Information
Serilog__MinimumLevel__Override__Microsoft=Warning
Serilog__MinimumLevel__Override__System=Warning

# =============================================================================
# FILE STORAGE CONFIGURATION
# =============================================================================

# S3 Configuration (if using S3 for file storage)
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET_NAME=your-normaize-bucket

# Local Storage Path (if using local file storage)
# FileStorage__BasePath=/app/data

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================

# Seq Logging (if using structured logging)
# Serilog__WriteTo__1__Name=Seq
# Serilog__WriteTo__1__Args__serverUrl=https://your-seq-instance.com
# Serilog__WriteTo__1__Args__apiKey=your-seq-api-key

# Application Insights (if using Azure monitoring)
# APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Disable sensitive data logging in production
Logging__LogLevel__Microsoft.EntityFrameworkCore=Warning

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Database Connection Pool
# ConnectionStrings__DefaultConnection=...;Pooling=true;MinPoolSize=5;MaxPoolSize=100;

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================

# Enable/disable features
# Features__EnableDetailedLogging=false
# Features__EnableCaching=true
# Features__EnableMetrics=true

# =============================================================================
# RAILWAY-SPECIFIC CONFIGURATION
# =============================================================================

# Railway automatically provides these:
# PORT - The port your app should listen on
# RAILWAY_ENVIRONMENT - The environment name
# RAILWAY_PROJECT_ID - Your project ID
# RAILWAY_SERVICE_ID - Your service ID

# =============================================================================
# DEPLOYMENT HEALTH CHECK
# =============================================================================

# Health check timeout configuration
# HealthChecks__Timeout=30
# HealthChecks__DetailedErrors=false